   "source": [
    "# ceci est un commentaire\n",
    "def euclide_etendu (a, b):\n",
    "    if b == 0:\n",
    "        return (a, 1, 0)\n",
    "    else :\n",
    "        d, u1 , v1 = euclide_etendu (b, a % b)\n",
    "        u = v1\n",
    "        v = u1 - (a // b) * v1\n",
    "        return (d, u, v)"
   ]
  }
